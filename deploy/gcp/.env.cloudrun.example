# ============================================================
# Cloud Run + Neon/Supabase + Upstash + Vercel
# Copy to deploy/gcp/.env.cloudrun and fill in real values.
# Then:  bash deploy/gcp/deploy-cloudrun.sh
# ============================================================

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=multi-agent
CLOUD_RUN_SERVICE=multi-agent-api
CLOUD_RUN_WORKER_SERVICE=multi-agent-worker

# --- Django ---
SECRET_KEY=replace-with-long-random-secret-min-50-chars
JWT_SECRET=replace-with-long-random-jwt-secret
DEBUG=False
# After first deploy, set to your real Cloud Run host (from gcloud output)
ALLOWED_HOSTS=.run.app
SECURE_SSL_REDIRECT=False

# --- Vercel frontend (set after Vercel deploy) ---
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-app.vercel.app

# --- Neon or Supabase Postgres (use POOLED connection string) ---
# Neon: Dashboard → Connection string → Pooled
# Supabase: Project Settings → Database → URI (Transaction pooler)
DATABASE_URL=postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require

# --- Upstash Redis (TLS) ---
# Console → REST/Redis → redis URL looks like rediss://default:...@....upstash.io:6379
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379
# Upstash is DB-0 only — reuse same URL for Celery
CELERY_BROKER_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379
CELERY_RESULT_BACKEND=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_ENDPOINT.upstash.io:6379

# --- AI keys ---
GROQ_API_KEY=
OPENAI_API_KEY=

# --- Cloud Run sizing (lean) ---
# API: scale to zero; Worker: scale to zero (cold until a job wakes it — set WORKER min=1 if needed)
GUNICORN_WORKERS=1
CELERY_WORKERS=1
