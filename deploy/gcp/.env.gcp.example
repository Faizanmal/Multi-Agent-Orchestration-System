# ============================================================
# GCP backend deploy env template (frontend excluded)
# Compute Engine VM: copy to repo root as .env.gcp and use
#   docker compose -f docker-compose.gce.yml --env-file .env.gcp up -d --build
# Cloud Run: load the same keys into Secret Manager instead.
# ============================================================

# --- GCP project ---
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
ARTIFACT_REGISTRY_REPO=multi-agent
CLOUD_SQL_INSTANCE=multi-agent-pg
CLOUD_SQL_CONNECTION_NAME=your-gcp-project-id:us-central1:multi-agent-pg

# --- Django ---
SECRET_KEY=replace-with-long-random-secret-min-50-chars
DEBUG=False
ALLOWED_HOSTS=.run.app,your-api.example.com
CSRF_TRUSTED_ORIGINS=https://your-api.example.com,https://YOUR-SERVICE-HASH-uc.a.run.app
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
SECURE_SSL_REDIRECT=False
FRONTEND_URL=https://your-frontend.example.com
BACKEND_URL=https://your-api.example.com

# --- Database (Cloud SQL) ---
POSTGRES_DB=multi_agent_db
POSTGRES_USER=multi_agent_user
POSTGRES_PASSWORD=replace-with-strong-db-password
# Prefer unix socket on Cloud Run via CLOUD_SQL_CONNECTION_NAME above.
# DATABASE_URL can still supply user/password/db name:
DATABASE_URL=postgresql://multi_agent_user:replace-with-strong-db-password@/multi_agent_db

# --- Redis (Memorystore or self-hosted) ---
REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@MEMORYSTORE_IP:6379/0
CELERY_BROKER_URL=redis://:replace-with-strong-redis-password@MEMORYSTORE_IP:6379/1
CELERY_RESULT_BACKEND=redis://:replace-with-strong-redis-password@MEMORYSTORE_IP:6379/1

# --- Optional GCS media ---
GS_BUCKET_NAME=
# GOOGLE_CLOUD_PROJECT already set above is used as GS project id

# --- AI keys ---
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Auth ---
JWT_SECRET=replace-with-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-different-refresh-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Billing / APM (optional) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# --- Runtime sizing ---
GUNICORN_WORKERS=2
CELERY_WORKERS=2
PORT=8000
