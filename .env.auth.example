# ============================================================
# Authentication Environment Variables
# ============================================================
# Copy this file to .env and fill in all required values.
# NEVER commit .env to source control.
# ============================================================

# -----------------------------------------------------------
# Django Core
# -----------------------------------------------------------
SECRET_KEY=your-very-long-random-secret-key-min-50-chars
DEBUG=False

# -----------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------
# Primary signing secret for access tokens (REQUIRED)
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars

# Separate signing secret for refresh tokens (optional; falls back to JWT_SECRET)
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret

# Token issuer and audience (must match between issuer and verifier)
JWT_ISSUER=multiagent-ai
JWT_AUDIENCE=multiagent-ai-client

# -----------------------------------------------------------
# Firebase (for Firebase Email/Password auth)
# -----------------------------------------------------------
# Obtain these from Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Private key from the downloaded service account JSON (replace literal \n with \\n in .env)
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY_ID=your-key-id

# Public API key (used only in frontend Firebase SDK, not backend)
FIREBASE_API_KEY=AIzaSy...

# Whether to check Firebase token revocation (recommended True in production)
FIREBASE_CHECK_REVOKED=True

# -----------------------------------------------------------
# Google OAuth 2.0 / OpenID Connect
# -----------------------------------------------------------
# Obtain from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=123456789-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# Must match the redirect URI registered in Google Cloud Console (backend receives the code)
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/
# After exchange, backend redirects the browser to FRONTEND_URL/google/callback

# -----------------------------------------------------------
# GitHub OAuth
# -----------------------------------------------------------
# Obtain from GitHub → Settings → Developer Settings → OAuth Apps
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Must match the callback URL registered in the GitHub OAuth App (backend receives the code)
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback/
# After exchange, backend redirects the browser to FRONTEND_URL/github/callback

# -----------------------------------------------------------
# CORS / URLs
# -----------------------------------------------------------
FRONTEND_URL=https://your-frontend-domain.com
BACKEND_URL=https://your-api-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://app.your-domain.com

# -----------------------------------------------------------
# Database
# -----------------------------------------------------------
# Default: SQLite (dev only). Set DATABASE_URL for PostgreSQL in production.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# -----------------------------------------------------------
# Redis (required for production rate limiting and caching)
# -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------
# Email (for password reset emails)
# -----------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@your-domain.com

# -----------------------------------------------------------
# AI Provider Keys (existing)
# -----------------------------------------------------------
GROQ_API_KEY=gsk_...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# -----------------------------------------------------------
# Security (production)
# -----------------------------------------------------------
ALLOWED_HOSTS=your-api-domain.com,api.your-domain.com

# IP Whitelist for admin endpoints (comma-separated, empty = no restriction)
# IP_WHITELIST=10.0.0.1,10.0.0.2
