# ============================================================
# Multi-Agent System – environment template
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ============================================================
# AI provider keys
# ============================================================
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
GOOGLE_API_KEY=your_google_ai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AZURE_API_KEY=your_azure_api_key_here

# ============================================================
# Django core
# ============================================================
SECRET_KEY=your-very-long-random-secret-key-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================
# JWT
# ============================================================
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-secret
JWT_ISSUER=multiagent-ai
JWT_AUDIENCE=multiagent-ai-client

# ============================================================
# Firebase (optional – email/password via Firebase)
# ============================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_API_KEY=
FIREBASE_CHECK_REVOKED=False

# ============================================================
# Google OAuth (sign-in) – NOT the same as GOOGLE_API_KEY above
# Google Cloud Console → APIs & Services → Credentials
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback/

# ============================================================
# GitHub OAuth (sign-in)
# GitHub → Settings → Developer settings → OAuth Apps
# ============================================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/auth/github/callback/

# ============================================================
# Frontend / backend URLs
# ============================================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=True
WEBHOOK_URL=http://localhost:8000/webhooks/

# ============================================================
# Database (PostgreSQL)
# Prefer DATABASE_URL. Individual POSTGRES_* vars also work.
# Leave DATABASE_URL empty to fall back to SQLite (dev only).
# ============================================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/multi_agent_db
POSTGRES_DB=multi_agent_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Cloud SQL on Cloud Run / GCE (unix socket). When set, overrides TCP host.
# CLOUD_SQL_CONNECTION_NAME=your-project:us-central1:multi-agent-pg
#
# Neon / Supabase (preferred for Cloud Run) — use pooled URL:
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# ============================================================
# Redis
# ============================================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Upstash (Cloud Run) — use rediss:// and the SAME url for Celery (DB 0 only):
# REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379
# CELERY_BROKER_URL=rediss://default:TOKEN@xxxx.upstash.io:6379
# CELERY_RESULT_BACKEND=rediss://default:TOKEN@xxxx.upstash.io:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# In DEBUG, Redis is skipped unless this is true (avoids stalled Google/GitHub login)
REDIS_REQUIRED=false

# ============================================================
# GCP (optional)
# ============================================================
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GS_BUCKET_NAME=your-media-bucket
# CSRF_TRUSTED_ORIGINS=https://your-api.example.com
# SERVICE_ROLE=web
# PORT=8000

# ============================================================
# File storage / logging / performance
# ============================================================
MEDIA_ROOT=./media
STATIC_ROOT=./staticfiles
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
CELERY_WORKERS=4
MAX_CONCURRENT_AGENTS=10
# ============================================================
# Stripe billing (required for paid upgrades in production)
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs from your Dashboard → Products
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# ============================================================
# Production launch checklist
# ============================================================
# DEBUG=False
# SECRET_KEY=<generate a long random string>
# ALLOWED_HOSTS=your.domain.com
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://your.domain.com
# SECURE_SSL_REDIRECT=True
# REDIS_REQUIRED=true
# DEVELOPMENT_MODE=False
DEVELOPMENT_MODE=True
